---
import '../../styles/financial-ledger.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LedgerHeader from '../../components/LedgerHeader.astro';
import LedgerEmpty from '../../components/LedgerEmpty.astro';
import {getCollection} from 'astro:content';
import {featuredFinanceSlug,financeDepartments,financeNotice} from '../../data/financialLedger.mjs';
const posts=(await getCollection('finance',({data})=>!data.draft)).sort((a,b)=>b.data.date.getTime()-a.data.date.getTime());
const feature=featuredFinanceSlug?posts.find(p=>p.id===featuredFinanceSlug):null;
const desk=posts.slice(0,4);
const humanDate = d => d.toLocaleDateString('en-CA',{year:'numeric',month:'short',day:'numeric',timeZone:'UTC'});
---
<BaseLayout title="The Financial Ledger" theme="finance">
 <div class="finance-wrap ledger-wrap">
  <LedgerHeader />
  <div class="ledger-front">
   <article class="ledger-feature">
    <p class="ledger-kicker">LEAD STORY · EDITOR'S SELECTION</p>
    {feature ? <>
     <h1><a href={`/finance/${feature.id}/`}>{feature.data.title}</a></h1>
     {feature.data.description&&<p class="ledger-deck">{feature.data.description}</p>}
     {feature.data.image&&<a href={`/finance/${feature.id}/`}><img class="ledger-lead-img" src={feature.data.image} alt="Feature article illustration"/></a>}
     <div class="ledger-feature-meta"><span>{feature.data.category} · {humanDate(feature.data.date)}</span><a href={`/finance/${feature.id}/`}>READ FULL ARTICLE ↗</a></div>
    </> : <>
     <h1>No article selected yet.</h1>
     <p class="ledger-deck">When you publish a financial article, you can choose it for the front page in <code>src/data/financialLedger.mjs</code>.</p>
     <div class="ledger-hero-rest" aria-label="The lead story is awaiting an editorial selection"><span>THE FEATURE DESK</span></div>
     <div class="ledger-feature-meta"><span>EDITORIAL SELECTION OPEN</span><span>THE FINANCIAL LEDGER</span></div>
    </>}
   </article>
   <aside class="ledger-reading" aria-label="The Reading Desk">
    <h2>THE READING DESK</h2><p class="ledger-smallcaps">FOUR MOST RECENT PUBLICATIONS</p>
    {Array.from({length:4},(_,i)=>desk[i]||null).map((post,i)=><div class="ledger-desk-entry">
      <div class="ledger-desk-number">{String(i+1).padStart(2,'0')}</div>
      <div>{post?<><a href={`/finance/${post.id}/`} class="ledger-desk-title">{post.data.title}</a><small>{post.data.category} · {humanDate(post.data.date)}</small></>:<><span class="ledger-desk-title">No recent article</span><small>New research will appear here.</small></>}</div>
     </div>)}
   </aside>
  </div>
  <section class="ledger-index"><h2>INSIDE THIS PUBLICATION</h2><div class="ledger-index-grid">
   {financeDepartments.map(d=><a href={`/finance/page/${d.number}/`} class="ledger-index-link"><span>P. {d.number}</span><h3>{d.name}</h3><p>{d.description}</p><small>TURN TO PAGE {d.number} ↗</small></a>)}
  </div></section>
  <section class="ledger-bottom"><div><p class="ledger-kicker">THE COMPLETE RECORD</p><h2>Looking for an earlier issue of an idea?</h2><p>Browse every publication, or search by keyword, category, and date.</p></div><a href="/finance/archive/" class="ledger-archive-link">VISIT THE ARCHIVE ↗</a></section>
  <p class="ledger-disclaimer">{financeNotice}</p>
 </div>
</BaseLayout>
