---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {getCollection} from 'astro:content';
const posts=(await getCollection('writing',({data})=>!data.draft)).sort((a,b)=>b.data.date-a.data.date);
const writingSettings = {
  substackUrl: 'https://proofbyconfusion.substack.com/',

  featuredEssay: {
    title: "The stuff I didn’t say to my professor about the Upaniṣads",
    description: "are we really understanding these texts or just moulding them into our categories ?",
    url: 'https://proofbyconfusion.substack.com/p/the-stuff-i-didnt-say-to-my-professor',
  },
};
---
<BaseLayout title="Writing" theme="writing">
    <section class="writing-banner">
        <div>
            <p class="eyebrow">ESSAYS · STORIES · PUBLISHED WORK</p>
            <h1>Writing</h1>
            <p>Longer-form essays, articles, and published work.</p>
        </div>
    </section>
    <div class="writing-content">
        <a class="writing-feature" href={writingSettings.featuredEssay.url}>
            <p class="eyebrow">FEATURED ESSAY</p>
            <h2>{writingSettings.featuredEssay.title}</h2>
            <p>{writingSettings.featuredEssay.description}</p>
            <span>Read the essay ↗</span>
        </a>
        <a class="substack-card" href={writingSettings.substackUrl}>
            <div class="substack-icon">▰</div>
            <div>
                <h3>Proof by Confusion</h3>
                <p>Visit my publication on Substack.</p>
                <span>Read on Substack ↗</span>
            </div>
        </a>
    </div>
</BaseLayout>
