---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {getCollection} from 'astro:content';
const posts=(await getCollection('writing',({data})=>!data.draft)).sort((a,b)=>b.data.date-a.data.date);
---
<BaseLayout title="Writing" theme="writing"><section class="writing-banner"><div><p class="eyebrow">ESSAYS · STORIES · PUBLISHED WORK</p><h1>Writing</h1><p>Longer-form essays, articles, and published work.</p></div></section><div class="writing-content"><div class="writing-feature"><p class="eyebrow">FEATURED ESSAY</p><h2>The Stuff I Didn't Say to My Professor</h2><p>On philosophical questions that refuse to stay inside the classroom.</p><span>First published on Substack</span></div><div class="substack-card"><div class="substack-icon">▰</div><div><h3>On Substack</h3><p>Essays on mathematics, finance, philosophy, and more.</p><p class="substack-setup">Add your Substack URL to connect this page to your existing writing.</p></div></div><section class="writing-list"><h2>Recent writing</h2>{posts.length?posts.map(p=><p><a href={`/writing/${p.id}/`}>{p.data.title} ↗</a> — {p.data.description}</p>):<p>No articles published here yet. Add a Markdown file in <code>src/content/writing/</code>.</p>}</section></div></BaseLayout>
