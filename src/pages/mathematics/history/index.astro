---
import MathematicsLayout from '../../../layouts/MathematicsLayout.astro';
import '../../../styles/math-independent.css';
import { getCollection, getEntry, render } from 'astro:content';
const entries = (await getCollection('mathematicalHistory', ({data}) => !data.draft))
  .sort((a,b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title));
const grouped = new Map();
for (const entry of entries) {
  const group = grouped.get(entry.data.period) ?? [];
  group.push(entry);
  grouped.set(entry.data.period, group);
}
const intro = await getEntry('mathematicalHistoryIntro', 'overview');
const introView = intro ? await render(intro) : null;
---
<MathematicsLayout title="Mathematical History" eyebrow="MATHEMATICS / ACADEMIC CHRONOLOGY" description="The mathematics I studied, the courses I took, and the people under whose guidance I learned.">
  <div class="math-inner-paper">
    <div class="math-section-intro"><h2>An academic record</h2>
      {introView ? <div class="math-history-intro math-md-content"><introView.Content /></div> : <p>A history of coursework, readings, and mathematical research.</p>}
    </div>
    {Array.from(grouped, ([period, items]) => <section class="math-history-period"><h3>{period}</h3>
      <div class="math-history-items">{items.map(entry => <div class="math-history-item">
        <div class="math-history-row"><a class="math-course-name" href={`/mathematics/history/${entry.id}/`}>{entry.data.code ? `${entry.data.code} — ` : ''}{entry.data.title} ↗</a>
          {entry.data.notes && <a class="math-pdf-label" href={entry.data.notes}>PDF NOTES ↓</a>}</div>
        <p>{entry.data.institution}{entry.data.instructor && ` · Instructor: ${entry.data.instructor}`}</p>
      </div>)}</div>
    </section>)}
    {entries.length === 0 && <p>No entries yet. Add a Markdown file to <code>src/content/math-history/</code>.</p>}
  </div>
</MathematicsLayout>
