---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {getCollection} from 'astro:content';
import '../../styles/section-search.css';
const sampleProjects=[{title:'Career Agent',category:'AUTOMATION',tags:['Python','SQLite','Automation'],image:'https://images.unsplash.com/photo-1451187580459-43490279c0fa?auto=format&fit=crop&w=900&q=85',text:'A local-first tool for discovering roles and preparing tailored applications.'},{title:'Valuation Model',category:'FINANCE',tags:['DCF','Equity Research'],image:'https://images.unsplash.com/photo-1611974789855-9c2a0a7236a3?auto=format&fit=crop&w=900&q=85',text:'Thinking through financial statements, forecasts, and company valuation.'},{title:'The Algebraic Picture',category:'MATHEMATICS',tags:['Algebra','Writing'],image:'https://images.unsplash.com/photo-1509228468518-180dd4864904?auto=format&fit=crop&w=900&q=85',text:'An interconnected exposition of algebra from sets to structural constructions.',href:'/mathematics/algebraic-picture/'},{title:'Future Projects',category:'EXPERIMENTS',tags:['Ideas','In progress'],image:'https://images.unsplash.com/photo-1519681393784-d120267933ba?auto=format&fit=crop&w=900&q=85',text:'A place for experiments, prototypes, and things not yet finished.'}];
const added=(await getCollection('projects',({data})=>!data.draft)).sort((a,b)=>a.data.order-b.data.order).map(p=>({title:p.data.title,category:p.data.category,tags:p.data.tags,image:p.data.image||'https://images.unsplash.com/photo-1519681393784-d120267933ba?auto=format&fit=crop&w=900&q=85',text:p.data.summary,href:`/projects/${p.id}/`}));
const projects=[...sampleProjects,...added];
---
<BaseLayout title="Projects" theme="projects">
    <section class="projects-head">
        <p class="eyebrow">EXPERIMENTS · TOOLS · RESEARCH</p>
        <h1>Projects</h1>
        <p>Things I've built, explored, or am still working on.</p>
    </section>
    <div data-search-root>
        <div class="projects-search-holder">
            <label class="site-search">
                <svg aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7">
                    <circle cx="10.8" cy="10.8" r="7.2"/>
                    <path d="m16.1 16.1 5 5"/>
                </svg>
                <input data-search-input type="search" autocomplete="off" placeholder="Search projects by name or technology…" aria-label="Search projects"/>
                <button type="button" data-search-clear aria-label="Clear search" hidden>Clear</button>
            </label>
            <p class="site-search-count" data-search-count aria-live="polite"></p>
            <p class="site-search-empty" data-search-empty hidden>No matching entries found.</p>
        </div>
        <div class="project-filters" aria-label="Filter projects">
            <button class="chosen" data-filter="ALL">All</button>
            <button data-filter="AUTOMATION">Automation</button>
            <button data-filter="FINANCE">Finance</button>
            <button data-filter="MATHEMATICS">Mathematics</button>
            <button data-filter="EXPERIMENTS">Other</button>
        </div>
        <div class="project-grid">{projects.map(p=><article data-search-item data-search-text={`${p.title} ${p.category} ${p.tags.join(' ')} ${p.text}`} class="project-card" data-category={p.category}><img src={p.image} alt="" loading="lazy"/><div class="project-inner"><p class="eyebrow">{p.category}</p><h2>{p.title}</h2><p>{p.text}</p><div class="project-tags">{p.tags.map(t=><span>{t}</span>)}</div>{p.href?<a href={p.href}>Explore ↗</a>:<span class="inprogress">Details to be added</span>}</div></article>)}</div></div></BaseLayout>

<script>import "../../scripts/section-search.js";</script>
