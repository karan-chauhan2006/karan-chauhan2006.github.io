---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {getCollection,render} from 'astro:content';
export async function getStaticPaths(){
 const items=await getCollection('projects',({data})=>!data.draft);
 return items.map(item=>({params:{slug:item.id},props:{item}}));
}
const {item}=Astro.props;
const {Content}=await render(item);
---
<BaseLayout title={item.data.title} theme="projects"><article class="publishing-reader"><a href="/projects/">← Projects</a><h1>{item.data.title}</h1><p>{item.data.summary}</p><div class="publishing-body"><Content /></div></article></BaseLayout>
